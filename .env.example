# Safe local-development template. Copy to .env and replace the placeholders.
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
JSON_LOGS=true

OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-local-service-role-key
SUPABASE_TIMEOUT_SECONDS=15
READINESS_TIMEOUT_SECONDS=3

# Format: key-id:secret. Use a randomly generated 32+ character secret in production.
WIDGET_SIGNING_KEYS=v1:development-only-signing-secret-change-me
WIDGET_ACTIVE_KID=v1
WIDGET_TOKEN_MAX_AGE_SECONDS=900
ALLOW_LOCALHOST_ORIGINS=true
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BYTES=65536
MAX_MESSAGE_CHARS=4000

CHAT_PERSISTENCE=true
TOP_K=8
MIN_SCORE_DEFAULT=0.0
QUERY_CLASSIFIER_MODEL=gpt-5-mini

RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_RATE_LIMIT_REQUESTS_PER_MINUTE=45
SESSION_RATE_LIMIT_WINDOW_SECONDS=60
TOKEN_ISSUE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
TOKEN_ISSUE_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_URL=

QUERY_CACHE_ENABLED=false
QUERY_CACHE_REDIS_URL=
QUERY_CACHE_TTL_SECONDS=900
QUERY_CACHE_NAMESPACE=qcache:v1
QUERY_CACHE_SEMANTIC_THRESHOLD=0.8
QUERY_CACHE_SEMANTIC_MAX_CANDIDATES=200
QUERY_CACHE_REQUIRE_RESTAURANT_RELEVANCE=true
QUERY_CACHE_CLASSIFIER_MODEL=gpt-5-nano
QUERY_CACHE_CLASSIFIER_TIMEOUT_MS=250

STRIPE_WEBHOOKS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
